# Public URL of the app (used in email and WhatsApp links)
APP_URL=http://localhost:3000

# Claude API key for the move-out photo/video comparison
ANTHROPIC_API_KEY=

# Optional: send real emails through Resend (https://resend.com). Without it, emails show on the in-app "Emails" page.
RESEND_API_KEY=
EMAIL_FROM="Handover AI <noreply@yourdomain.com>"

# Optional: show a clearly labelled placeholder AI report when no ANTHROPIC_API_KEY is set (for demos)
AI_DEMO=0

# Time zone used to display dates
DISPLAY_TZ=Asia/Qatar

# PostgreSQL connection. Tables are created automatically on first start.
DATABASE_URL=postgres://postgres:dev@localhost:5432/handover
# Connections per server instance (Cloud SQL allows a fixed total, see deploy/README.md)
PG_POOL_MAX=10

# Photos and videos: set a Cloud Storage bucket in production. Empty = files on local disk under DATA_DIR.
GCS_BUCKET=
# Local disk for uploads (when GCS_BUCKET is empty) and temporary files
DATA_DIR=./data

# Background jobs (video previews, AI comparisons, emails).
# "worker" = only a separate `npm run worker` process runs them (production). Anything else = run inside the web app.
JOB_MODE=
WORKER_CONCURRENCY=2

# Number of proxies in front of the app, used to find the real client IP for rate limits (2 behind Google's load balancer)
TRUSTED_PROXY_HOPS=1
# Set to "off" only for load tests
RATE_LIMITS=

# Optional: Google sign-in (create an OAuth client at console.cloud.google.com)
# Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paid plans for landlords (tenants are always free). Off unless set to 1: then everyone gets every feature.
PAYMENTS_ENABLED=0
# "tap" (Tap Payments: Apple Pay + cards) or "fake" (in-app test checkout, no money moves)
PAYMENTS_PROVIDER=tap
TAP_SECRET_KEY=
# Prices in QAR (defaults shown)
PRICE_PRO_MONTH=49
PRICE_PRO_YEAR=490
PRICE_BUSINESS_MONTH=199
PRICE_BUSINESS_YEAR=1990

# Inspection reminders (sent by the worker 7, 3, 1 days before, on the day, then every 2 days overdue, 9:00-21:00).
# Set to "off" to stop them.
REMINDERS=
# WhatsApp reminders through the WhatsApp Business Cloud API (Meta). Without these, copies are only shown under Messages.
# The template must be approved in each language you use (en, ar, hi, ml, ur, fr, es). See deploy/README.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=inspection_reminder
WHATSAPP_API_VERSION=v23.0
# Phone and browser notifications (web push). Make a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
